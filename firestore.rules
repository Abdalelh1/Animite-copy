rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isCallerAdmin() {
      return isAuthenticated() && (
        request.auth.token.get('admin', false) == true
        || request.auth.token.get('role', '') in ['admin', 'owner', 'moderator']
      );
    }

    function isCallerOwner() {
      return isAuthenticated() && (
        request.auth.token.get('role', '') == 'owner'
        || request.auth.token.get('isOwner', false) == true
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isOwner', false) == true
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'owner'))
      );
    }

    function isUserElite(userData) {
      return userData.get('tier', 'regular') == 'elite'
        || userData.get('isOwner', false) == true
        || userData.get('role', 'user') == 'owner';
    }

    function isValidText(text, minLen, maxLen) {
      return text is string && text.size() >= minLen && text.size() <= maxLen;
    }

    function getSystemSettings() {
      return get(/databases/$(database)/documents/system_settings/config).data;
    }

    function isSystemInMaintenance() {
      return exists(/databases/$(database)/documents/system_settings/config)
        && getSystemSettings().get('maintenanceMode', false) == true;
    }

    function areRegistrationsAllowed() {
      return !exists(/databases/$(database)/documents/system_settings/config)
        || getSystemSettings().get('allowRegistrations', true) != false;
    }

    function areCommentsEnabled() {
      return isCallerAdmin()
        || !exists(/databases/$(database)/documents/system_settings/config)
        || getSystemSettings().get('commentsEnabled', true) != false;
    }

    function areDirectMessagesEnabled() {
      return isCallerAdmin()
        || !exists(/databases/$(database)/documents/system_settings/config)
        || getSystemSettings().get('directMessagesEnabled', true) != false;
    }

    // User profile: users/{userId}
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId)
        && (!isSystemInMaintenance() || isCallerOwner())
        && areRegistrationsAllowed()
        && isValidText(request.resource.data.username, 3, 30)
        && isValidText(request.resource.data.displayName, 1, 50)
        && !('email' in request.resource.data)
        && !('phoneNumber' in request.resource.data)
        && (!('role' in request.resource.data) || request.resource.data.role == 'user')
        && (!('tier' in request.resource.data) || request.resource.data.tier == 'regular')
        && (!('isOwner' in request.resource.data) || request.resource.data.isOwner == false)
        && (!('eliteGrantedAt' in request.resource.data) || request.resource.data.eliteGrantedAt == null)
        && (!('eliteGrantedBy' in request.resource.data) || request.resource.data.eliteGrantedBy == null)
        && (!('eliteBadges' in request.resource.data) || (request.resource.data.eliteBadges is list && request.resource.data.eliteBadges.size() == 0))
        && (!('liveCoverUrl' in request.resource.data) || request.resource.data.liveCoverUrl == null)
        && (!('liveCoverPosterUrl' in request.resource.data) || request.resource.data.liveCoverPosterUrl == null)
        && (!('liveCoverMediaType' in request.resource.data) || request.resource.data.liveCoverMediaType == null);
      allow update: if (!isSystemInMaintenance() || isCallerOwner()) && (
        // Self-update by the user
        (isOwner(userId)
          && request.resource.data.uid == userId
          && (request.resource.data.username == resource.data.username || isValidText(request.resource.data.username, 3, 30))
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email', 'phoneNumber', 'roles', 'role', 'isVerified', 'isBanned', 'isSuspended', 'premiumUntil', 'tier', 'eliteGrantedAt', 'eliteGrantedBy', 'eliteBadges', 'isOwner', 'customBadgeTitle'])
          && (isUserElite(resource.data) || isCallerOwner() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['liveCoverUrl', 'liveCoverPosterUrl', 'liveCoverMediaType'])))
        // Owner promotion/demotion and role management
        || (isCallerOwner()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isOwner'])
          && (!('tier' in request.resource.data) || request.resource.data.tier in ['regular', 'elite'])
          && (!('eliteBadges' in request.resource.data) || request.resource.data.eliteBadges is list))
        // Followers counter updates
        || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount']))
      );
      allow delete: if false;

      // Notifications: users/{userId}/notifications/{notificationId}
      match /notifications/{notificationId} {
        allow read, delete: if isOwner(userId);
        allow create: if isAuthenticated() && request.resource.data.recipientId == userId && (
          (request.resource.data.senderId == request.auth.uid && request.resource.data.senderId != userId && request.resource.data.type in ['like', 'comment', 'reply', 'follow'])
          || (isOwner(userId) && request.resource.data.type == 'episode')
        );
        allow update: if isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'isRead']);
      }

      // Followers subcollection: users/{userId}/followers/{followerUid}
      match /followers/{followerUid} {
        allow read: if true;
        allow create: if isAuthenticated() && request.auth.uid == followerUid && followerUid != userId;
        allow delete: if isAuthenticated() && request.auth.uid == followerUid;
      }

      // Following subcollection: users/{userId}/following/{followingUid}
      match /following/{followingUid} {
        allow read: if true;
        allow create: if isOwner(userId) && followingUid != userId;
        allow delete: if isOwner(userId);
      }

      // Blocked users: users/{userId}/blocks/{blockedUid}
      match /blocks/{blockedUid} {
        allow read, write: if isOwner(userId);
      }

      // User Anime Library: users/{userId}/library/{animeId}
      match /library/{animeId} {
        allow read, write: if isOwner(userId);
      }

      // User Watch Progress: users/{userId}/watch_progress/{animeId}
      match /watch_progress/{animeId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Unique username registry: usernames/{username}
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Comments: comments/{commentId}
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && (!isSystemInMaintenance() || isCallerOwner())
        && areCommentsEnabled()
        && request.resource.data.authorId == request.auth.uid
        && isValidText(request.resource.data.content, 0, 2000)
        && (request.resource.data.createdAt is number || request.resource.data.createdAt == request.time);
      allow update: if isAuthenticated() && (
        // Author updating their own comment
        (request.auth.uid == resource.data.authorId
          && (!isSystemInMaintenance() || isCallerOwner())
          && areCommentsEnabled()
          && isValidText(request.resource.data.content, 0, 2000)
          && request.resource.data.authorId == resource.data.authorId)
        // Public counters: likesCount, replyCount, reportCount
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'replyCount', 'reportCount']))
        // Author soft-delete or Admin/Owner moderation
        || ((request.auth.uid == resource.data.authorId || isCallerAdmin()) && request.resource.data.get('isDeleted', false) == true)
      );
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.authorId || isCallerAdmin());

      // Likes subcollection: comments/{commentId}/likes/{userId}
      match /likes/{userId} {
        allow read: if true;
        allow create, delete: if isOwner(userId) && (!isSystemInMaintenance() || isCallerOwner());
      }
    }

    // Dedicated Posts collection: posts/{postId}
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && (!isSystemInMaintenance() || isCallerOwner())
        && areCommentsEnabled()
        && request.resource.data.authorId == request.auth.uid
        && isValidText(request.resource.data.content, 0, 2000)
        && (request.resource.data.createdAt is number || request.resource.data.createdAt == request.time);
      allow update: if isAuthenticated() && (
        // Author updating their own post
        (request.auth.uid == resource.data.authorId
          && (!isSystemInMaintenance() || isCallerOwner())
          && areCommentsEnabled()
          && isValidText(request.resource.data.content, 0, 2000)
          && request.resource.data.authorId == resource.data.authorId)
        // Public counters: likesCount, commentCount
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentCount']))
        // Author soft-delete or Admin/Owner moderation
        || ((request.auth.uid == resource.data.authorId || isCallerAdmin()) && request.resource.data.get('isDeleted', false) == true)
      );
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.authorId || isCallerAdmin());

      // Dedicated Post Likes subcollection: posts/{postId}/likes/{userId}
      match /likes/{userId} {
        allow read: if true;
        allow create, delete: if isOwner(userId) && (!isSystemInMaintenance() || isCallerOwner());
      }
    }

    // Private Conversations: conversations/{conversationId}
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated()
        && (!isSystemInMaintenance() || isCallerOwner())
        && areDirectMessagesEnabled()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      // Direct Messages: conversations/{conversationId}/messages/{messageId}
      match /messages/{messageId} {
        allow read: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isAuthenticated()
          && (!isSystemInMaintenance() || isCallerOwner())
          && areDirectMessagesEnabled()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && isValidText(request.resource.data.text, 1, 4000)
          && request.resource.data.timestamp == request.time;
        allow update: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if isAuthenticated() && request.auth.uid == resource.data.senderId;
      }
    }

    // Reports: reports/{reportId}
    match /reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isCallerAdmin();
    }

    // Immutable Audit Logs: audit_logs/{logId}
    match /audit_logs/{logId} {
      // Only owners can read audit logs
      allow read: if isCallerOwner();
      // Audit logs are generated and written strictly by trusted backend Cloud Functions (Admin SDK)
      allow write: if false;
    }

    // Anime Lists: anime_lists/{entryId}
    match /anime_lists/{entryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.animeId is int
        && request.resource.data.animeTitle is string
        && request.resource.data.watchStatus in ['WATCHING', 'COMPLETED', 'ON_HOLD', 'DROPPED', 'PLAN_TO_WATCH']
        && request.resource.data.progress is int
        && request.resource.data.progress >= 0;
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.animeId == resource.data.animeId;
      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    // Anime & Character Arabic Translations: anime_translations/{docId}
    match /anime_translations/{docId} {
      allow read: if true;
      allow write: if isAuthenticated() || true; // Allow client community translation contributions
    }

    // System Settings: system_settings/{settingId}
    match /system_settings/{settingId} {
      // Global config is public for client maintenance mode & settings
      allow read: if settingId == 'config';
      // Ownership registry is restricted to owners
      allow read: if settingId == 'ownership_registry' && isCallerOwner();
      // All system settings writes are executed exclusively by trusted backend Cloud Functions
      allow write: if false;
    }
  }
}
