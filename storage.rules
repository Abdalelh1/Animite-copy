rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isCallerAppOwner() {
      return isAuthenticated() && (
        request.auth.token.get('role', '') == 'owner'
        || request.auth.token.get('isOwner', false) == true
        || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isOwner', false) == true
        || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'owner'
      );
    }

    function isEliteUser(userId) {
      return isAuthenticated() && (
        request.auth.token.get('tier', '') == 'elite'
        || isCallerAppOwner()
        || firestore.get(/databases/(default)/documents/users/$(userId)).data.get('tier', 'regular') == 'elite'
      );
    }

    // Avatars: avatars/{userId}/{fileName}
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Static Banners: banners/{userId}/{fileName}
    // Animated GIFs or videos in banners/ require elite tier; static images are open to the profile owner.
    match /banners/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) && (
        (request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/(jpeg|png)'))
        || (isEliteUser(userId)
          && request.resource.size < 40 * 1024 * 1024
          && (request.resource.contentType.matches('image/(gif|webp)') || request.resource.contentType.matches('video/mp4')))
      );
    }

    // Live / Animated Covers (GIF/WebP/MP4): live_covers/{userId}/{fileName}
    // Strictly restricted to elite accounts (or the app owner).
    match /live_covers/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId)
        && isEliteUser(userId)
        && request.resource.size < 40 * 1024 * 1024
        && (request.resource.contentType.matches('video/mp4')
          || request.resource.contentType.matches('image/gif')
          || request.resource.contentType.matches('image/webp'));
    }
  }
}
